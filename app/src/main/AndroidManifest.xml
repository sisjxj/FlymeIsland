<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- UI-only coexistence preview: no Xposed metadata, no background service,
         no notification listener and no privileged permissions. -->
    <application
        android:label="Flyme Island · 声明预览"
        android:icon="@drawable/ic_island"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity android:name=".NoticePreviewActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
